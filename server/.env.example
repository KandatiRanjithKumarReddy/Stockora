PORT=5000
NODE_ENV=development
ENABLE_DEMO_AUTH=true
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/stockora?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Gemini AI Cascade (Single API Key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_SECONDARY_MODEL=gemini-3.5-flash
GEMINI_TERTIARY_MODEL=gemini-3.1-flash-lite

# Business Configuration
STOCK_RESERVATION_EXPIRY_MINUTES=1440
CLIENT_ORIGIN=http://localhost:5173

